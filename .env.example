# Optional for local development. Never commit your real .env file.
# Generate with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
# Set to true only when your site uses HTTPS.
COOKIE_SECURE=false
# Defaults to instance/users.db; on EC2 use /var/lib/aws-authenticator/users.db.
# DATABASE_PATH=
